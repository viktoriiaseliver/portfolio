---
import Base from './Base.astro';
import Contact from '../components/organisms/Contact.astro';
import Slot from '../components/atoms/Slot.astro';
import Button from '../components/atoms/Button.astro';
import Chip from '../components/atoms/Chip.astro';
import Heading from '../components/atoms/Heading.astro';
import Marks from '../components/atoms/Marks.astro';
import Segmented from '../components/atoms/Segmented.astro';
import Panel from '../components/molecules/Panel.astro';
import FactCard from '../components/molecules/FactCard.astro';
import CaseHero from '../components/organisms/CaseHero.astro';
import Ph from '../components/atoms/Ph.astro';
import { url } from '../lib/url';
import { filled, visible, SHOW_PLACEHOLDERS } from '../lib/placeholder';
import type { OpenCase } from '../cases/types';

interface Props { c: OpenCase }
const { c } = Astro.props;
const nav = [{ href: '/#work', label: 'Proof' }, { href: '/work', label: 'All work' }, { href: '/about', label: 'About' }];

// Optional chapters appear once their copy is written (or in dev as drafts).
const showResearch = c.insights.some((i) => visible(i.quote));
const showExplored = visible(c.explored.alternative) && visible(c.explored.reason);
const contextOk = c.problem.context.every(filled) || SHOW_PLACEHOLDERS;
const chapters = [
  ['problem', 'Problem', false],
  ...(showResearch ? [['research', 'Research', true]] : []),
  ['decisions', 'Decisions', false],
  ['journey', 'In use', false],
  ...(showExplored ? [['explored', 'Explored', true]] : []),
  ['result', 'Result', false]
] as [string, string, boolean][];

const BEFORE = [[18, 24], [82, 24], [18, 80], [82, 80]], AFTER = [[14, 56], [38, 56], [62, 56], [86, 56]];
const NODES = [['Web app 1', 'app'], ['Web app 2', 'app'], ['Web app 3', 'app'], ['Mobile app', 'phone']];
const losses = [[34, 38], [66, 66], [64, 37]];
const nextOn = Math.round(c.next.pct / 10);
const R = c.result;
const extra = (R.extra ?? []).filter((x) => visible(x.n) && visible(x.what));
---
<Base title={`${c.title.a}${c.title.b} — Viktoriia Seliverstova`} description={c.lead} nav={nav} progress depth>
<main class="page case" data-case data-depth="full">

  <CaseHero industry={c.industry} title={c.title} lead={c.lead} facts={c.facts}>
    <span slot="badge" class="label on-ink-muted">{c.kicker}</span>
    <div slot="visual" class="chero-cover" style={`background-image:url(${url(c.cover)})`}>
      <div class="chero-chips">{c.chips.map((r) => <div class="gchip-dark"><div class="num gchip-n">{r.num}</div><div class="gchip-w">{r.what}</div></div>)}</div>
    </div>
  </CaseHero>

  <section id="facts" class="grid-4">
    <FactCard tone="brand" n={`${R.sign}${R.n}`} unit={`${R.unit} ${R.b}`}>
      <div class="q-foot"><Marks total={R.n} style="--on:var(--periwinkle)" /><span class="label-s mist" style="letter-spacing:0">1 BLOCK = 1 MINUTE</span></div>
    </FactCard>
    <FactCard n={c.workflow.n} unit={c.workflow.what}>
      <div class="q-foot"><div class="q-flow"><div class="q-apps"><i></i><i></i><i></i><i class="ph-m"></i></div><span class="muted">→</span><i class="q-one"></i></div><span class="label-s muted" style="letter-spacing:0">{c.workflow.caption}</span></div>
    </FactCard>
    <FactCard n={c.roles.length} unit="roles, one order">
      <div class="q-roles">{c.roles.map((r) => <Chip tone="white"><i class="role-ic"></i>{r}</Chip>)}</div>
    </FactCard>
    <FactCard title="My zone">
      <div class="q-zone">{c.zone.map((t, i) => <div class:list={{ last: i === c.zone.length - 1 }}>{t}</div>)}</div>
    </FactCard>
  </section>

  <section class="cbody">
    <aside class="rail" data-rail>
      {chapters.map(([id, t, full], i) => <a href={`#${id}`} class="rail-a" data-rail-link={id} data-full={full ? '' : undefined}><span class="label-s rail-n" data-chap-n={id}>{String(i + 1).padStart(2, '0')}</span>{t}</a>)}
      <a href="#result" class="rail-skip">Skip to result ↓</a>
    </aside>

    <div class="chapters">

      <div id="problem" class="chap" data-chapter>
        <span class="label chap-k"><span data-chap-n="problem">01</span> · PROBLEM</span>
        <div class="prob-head">
          <Heading size="h3" a={c.problem.a} b={c.problem.b} class="prob-h" />
          <Segmented items={[{ label: 'Before', selected: true, attrs: { 'data-ba': '0' } }, { label: 'After', attrs: { 'data-ba': '1' } }]} label="Before or after" role="tablist" tone="ink" size="lg" class="soft-track" />
        </div>
        <Panel tone="soft" pad="inset" class="prob-panel">
          <div class="dia" role="img" aria-label="Before: one order spread across three web apps and a mobile app, with lost context between them" data-dia>
            <svg class="dia-links" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">{BEFORE.map(([x, y]) => <line x1="50" y1="52" x2={x} y2={y} />)}</svg>
            <i class="dia-line"></i>
            {NODES.map(([t, k], i) => <div class="node" style={`--bx:${BEFORE[i][0]}%;--by:${BEFORE[i][1]}%;--ax:${AFTER[i][0]}%;--ay:${AFTER[i][1]}%`}><i class={k}></i><span class="label-s">{t}</span></div>)}
            {losses.map(([x, y]) => <span class="loss" style={`left:${x}%;top:${y}%`}><i class="ping"></i><i></i></span>)}
            <div class="dia-order" data-order>1 order</div>
            <span class="dia-legend label-s muted"><i></i><span data-legend>LOST CONTEXT</span></span>
          </div>
          {contextOk && (
            <div class="prob-ctx" data-full>
              <p>{c.problem.context.map((s, i) => <>{i > 0 && ' '}<Ph v={s} /></>)}</p>
            </div>
          )}
        </Panel>
      </div>

      {showResearch && (
        <div id="research" class="chap" data-chapter data-full>
          <span class="label chap-k"><span data-chap-n="research">02</span> · RESEARCH</span>
          <Heading size="h3" a="What I " b="found." />
          <div class="ins">{c.insights.filter((i) => visible(i.quote)).map((i) => <div class="ins-c"><span class="num ins-n">{i.n}</span><div class="ins-t"><span class="serif ins-q muted">“<Ph v={i.quote} />”</span><span class="label-s muted"><Ph v={i.src} /></span></div></div>)}</div>
        </div>
      )}

      <div id="decisions" class="chap decs" data-chapter>
        <div class="decs-head"><span class="label chap-k"><span data-chap-n="decisions">03</span> · DECISIONS</span><Heading size="h3" a="Three " b="decisions." /></div>
        {c.decisions.map((d, i) => {
          const notes = d.notes.filter(([, v]) => visible(v));
          return (
            <article class="dec">
              <div class="dec-head"><span class="num dec-n">{String(i + 1).padStart(2, '0')}</span><h3 class="dec-t">{d.t}</h3></div>
              <div class="dec-shot"><Slot label={d.ph} src={d.image} />{d.pins.map(([x, y], j) => <span class="pin" style={`left:${x}%;top:${y}%`}>{j + 1}</span>)}</div>
              {notes.length > 0 && <div class="dec-notes" data-full style={`--cols:${notes.length}`}>{notes.map(([k, v]) => <div><span class="label muted">{k}</span><span class="dec-v"><Ph v={v} /></span></div>)}</div>}
            </article>
          );
        })}
      </div>

      <div id="journey" class="chap journey" data-chapter data-journey>
        <div class="j-head">
          <div class="j-title"><span class="label mist"><span data-chap-n="journey">04</span> · IN USE</span><Heading size="h3" a="The path of " b="one order." /></div>
          <div class="j-ctrl"><Button variant="outline-light" data-play>Pause</Button><button type="button" class="icon-btn j-arr" aria-label="Previous step" data-step-prev>←</button><button type="button" class="icon-btn j-arr fwd" aria-label="Next step" data-step-next>→</button></div>
        </div>
        <div class="j-stations">{c.stations.map((s, i) => <button type="button" class:list={['j-st', { on: i === 0 }]} aria-pressed={i === 0 ? 'true' : 'false'} data-station={i}><i></i><span><span class="label-s mist" style="letter-spacing:0">{String(i + 1).padStart(2, '0')}</span><span class="j-st-t">{s.t}</span></span></button>)}</div>
        <div class="j-screen">
          {c.stations.map((s, i) => <div class="j-shot" data-shot={i} hidden={i !== 0}><Slot label={`Screen at the ${s.t.toLowerCase()}`} src={s.image} /></div>)}
          <span class="j-end" hidden data-j-end><span class="num j-end-n">{R.sign}{R.n} {R.unit}</span><span class="j-end-w">{R.b}</span></span>
        </div>
      </div>

      {showExplored && (
        <div id="explored" class="chap expl" data-chapter data-full>
          <div class="expl-img"><div class="expl-grey"><Slot label="Explored alternative" src={c.explored.image} /></div><span class="expl-strike"></span></div>
          <div class="expl-t"><span class="label muted">EXPLORED, NOT SHIPPED</span><p class="h5">I also explored <Ph v={c.explored.alternative} />. It tested worse because <Ph v={c.explored.reason} />.</p></div>
        </div>
      )}

      <div id="result" class="chap res" data-chapter data-result={R.n}>
        <div class="res-panel">
          <div class="res-top"><span class="label on-ink-muted"><span data-chap-n="result">05</span> · RESULT</span>{R.howMeasured && visible(R.howMeasured) && <span class="res-how" data-full>how measured · <Ph v={R.howMeasured} /></span>}</div>
          <div class="res-big"><span class="num res-n" aria-label={`${R.n} ${R.unit}`}>{R.sign}<span data-counter>0</span><span class="res-unit"> {R.unit}</span></span><span class="res-l">{R.a}<br /><span class="serif mist">{R.b}</span></span></div>
          <div class="res-mins" aria-hidden="true" style={`--n:${R.n}`}>{Array.from({ length: R.n }, () => <i></i>)}</div>
        </div>
        {extra.length > 0 && <div class="res-extra">{extra.map((x) => <div><span class="num"><Ph v={x.n} /></span><span class="mist"><Ph v={x.what} /></span></div>)}</div>}
        {R.lesson && visible(R.lesson.why) && <div class="lesson" data-full><span class="label">WHAT I'D DO DIFFERENTLY</span><p class="serif">{R.lesson.text} <Ph v={R.lesson.why} /></p></div>}
        <a class="next" href={url(c.next.href)}>
          <span class="next-l"><span class="label muted">NEXT CASE · {c.next.cat}</span><span class="h5">{c.next.name}</span></span>
          <span class="next-r"><span class="num next-n">{c.next.num}</span><Marks total={10} on={nextOn} height="24px" gap={4} class="next-ten" style="--on:var(--cobalt);--off:var(--cobalt-tint-strong);--off-o:.5" /><span class="muted next-w">{c.next.what} →</span></span>
        </a>
      </div>
    </div>
  </section>

  <Contact />
</main>
</Base>

<style>
  :global(html) { scroll-padding-top: 100px; }
  .case[data-depth='short'] [data-full] { display: none !important; }

  /* Hero */
  .chero-cover { position: relative; min-height: clamp(320px, 64vh, 640px); border-radius: var(--r-surface); overflow: hidden; background: var(--grey-210) center / cover no-repeat; }
  .chero-chips { position: absolute; left: 10px; right: 10px; bottom: 10px; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
  .gchip-dark { padding: 14px 16px; border-radius: var(--r-inner); background: var(--glass-dark-bg); backdrop-filter: var(--glass-dark-filter); -webkit-backdrop-filter: var(--glass-dark-filter); box-shadow: var(--glass-dark-shadow); color: var(--white); }
  .gchip-n { font-size: var(--t-h5); line-height: 1; letter-spacing: -.03em; }
  .gchip-w { font-size: var(--t-small); margin-top: 4px; opacity: .9; }

  /* Quick look */
  .q-foot { display: flex; flex-direction: column; gap: 8px; }
  .q-flow { display: grid; grid-template-columns: auto auto minmax(0, 1fr); align-items: center; gap: 12px; }
  .q-apps { display: flex; gap: 4px; align-items: flex-end; }
  .q-apps i { width: 26px; height: 18px; border-radius: var(--r-mark); background: var(--ink); }
  .q-apps i.ph-m { width: 12px; height: 22px; }
  .q-one { height: 28px; border-radius: var(--r-mark); background: var(--cobalt); }
  .q-roles { display: flex; flex-wrap: wrap; gap: 6px; }
  .q-roles :global(.chip) { padding: 7px 12px 7px 8px; }
  .role-ic { width: 10px; height: 16px; border-radius: 5px 5px 2px 2px; background: var(--ink); }
  .q-zone { display: flex; flex-direction: column; gap: 6px; }
  .q-zone div { padding: 9px 14px; border-radius: var(--r-tile); background: var(--ink); color: var(--white); font-size: var(--t-body); font-weight: 500; }
  .q-zone div.last { background: var(--cobalt); }

  /* Body + chapter rail */
  .cbody { padding-top: var(--block-top); display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: clamp(20px, 2.6vw, 40px); align-items: start; }
  .rail { position: sticky; top: 96px; z-index: 10; display: flex; flex-direction: column; gap: 4px; padding: 8px; border-radius: var(--r-inner); background: var(--glass-light-bg); backdrop-filter: var(--glass-light-filter); -webkit-backdrop-filter: var(--glass-light-filter); box-shadow: var(--glass-light-shadow); overflow-x: auto; scrollbar-width: none; }
  .rail-a { flex: none; display: flex; gap: 12px; align-items: center; min-height: var(--control-min); padding: 0 14px; border-radius: var(--r-pill); font-size: var(--t-small); text-decoration: none; white-space: nowrap; color: var(--ink); transition: background var(--d-fast) var(--ease), color var(--d-fast) var(--ease); }
  .rail-a.on { background: var(--ink); color: var(--white); }
  .rail-n { color: var(--text-secondary); letter-spacing: 0; }
  .rail-a.on .rail-n { color: var(--mist); }
  .rail-skip { flex: none; display: inline-flex; align-items: center; min-height: 44px; padding: 0 14px; margin-top: 8px; border-radius: var(--r-pill); font-size: var(--t-small); text-decoration: none; white-space: nowrap; color: var(--ink); box-shadow: inset 0 0 0 1.5px var(--ink); }
  @media (max-width: 1099px) {
    .cbody { grid-template-columns: minmax(0, 1fr); }
    .rail { top: 76px; flex-direction: row; }
    .rail-skip { margin-top: 0; }
  }
  .chapters { display: flex; flex-direction: column; gap: var(--section-top); min-width: 0; }
  .chap { display: flex; flex-direction: column; gap: 12px; }
  .chap-k { color: var(--cobalt); }

  /* Problem diagram */
  .prob-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; flex-wrap: wrap; }
  .prob-h { max-width: 18ch; }
  .prob-head :global(.soft-track) { background: var(--grey-238); padding: 4px; }
  .prob-panel { display: flex; flex-direction: column; gap: 12px; }
  .dia { position: relative; aspect-ratio: 16 / 9; min-height: 260px; border-radius: var(--r-inner); background: var(--white); overflow: hidden; }
  @media (max-width: 639px) { .dia { aspect-ratio: 4 / 3; } }
  .dia-links { position: absolute; inset: 0; width: 100%; height: 100%; transition: opacity var(--d-slow) var(--ease); }
  .dia-links line { stroke: var(--muted-on-ink); stroke-width: 2; stroke-dasharray: 6 5; vector-effect: non-scaling-stroke; }
  .dia-line { position: absolute; left: 14%; top: 56%; height: 3px; margin-top: -1.5px; width: 0; border-radius: var(--r-mark); background: var(--cobalt); transition: width var(--d-morph) var(--ease); }
  .node { position: absolute; left: var(--bx); top: var(--by); transform: translate(-50%, -50%); display: flex; flex-direction: column; align-items: center; gap: 8px; transition: left var(--d-morph) var(--ease), top var(--d-morph) var(--ease); }
  .node i { background: var(--ink); box-shadow: 0 6px 18px var(--shadow-ink); transition: background var(--d-slow) var(--ease); }
  .node i.app { width: 56px; height: 40px; border-radius: 8px; }
  .node i.phone { width: 26px; height: 44px; border-radius: 7px; }
  .node span { white-space: nowrap; }
  .loss { position: absolute; width: 14px; height: 14px; margin: -7px 0 0 -7px; transition: opacity var(--d-base) var(--ease); }
  .loss i { position: absolute; inset: 0; border-radius: var(--r-dot); background: var(--orange); }
  .loss .ping { animation: ping 1.8s ease-out infinite; }
  @keyframes ping { 0% { transform: scale(1); opacity: .6; } 100% { transform: scale(2.8); opacity: 0; } }
  .dia-order { position: absolute; left: 50%; top: 52%; transform: translate(-50%, -50%); padding: 12px 18px; border-radius: var(--r-inner); background: var(--cobalt); color: var(--white); font-size: var(--t-body); font-weight: 500; white-space: nowrap; box-shadow: 0 10px 28px var(--cobalt-tint-strong); transition: top var(--d-morph) var(--ease); }
  .dia-legend { position: absolute; right: 18px; bottom: 16px; display: inline-flex; align-items: center; gap: 6px; }
  .dia-legend i { width: 8px; height: 8px; border-radius: var(--r-dot); background: var(--orange); }
  .dia.after .dia-links, .dia.after .loss { opacity: 0; }
  .dia.after .dia-line { width: 72%; }
  .dia.after .node { left: var(--ax); top: var(--ay); }
  .dia.after .node i { background: var(--cobalt); }
  .dia.after .dia-order { top: 26%; }
  .dia.after .dia-legend i { background: var(--cobalt); }
  .prob-ctx { padding: 6px 12px 10px; }
  .prob-ctx p { font-size: var(--t-lead); line-height: 1.45; max-width: 60ch; }

  /* Research */
  .ins { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  @media (max-width: 1099px) { .ins { grid-template-columns: minmax(0, 1fr); } }
  .ins-c { display: flex; flex-direction: column; justify-content: space-between; gap: 32px; min-height: 220px; padding: var(--card-pad); border-radius: var(--r-card); background: var(--grey-238); }
  .ins-n { font-size: var(--t-h3); line-height: 1; letter-spacing: -.05em; color: var(--cobalt); }
  .ins-t { display: flex; flex-direction: column; gap: 12px; }
  .ins-q { font-size: var(--t-h5); line-height: 1; }

  /* Decisions */
  .decs { gap: var(--block-top); }
  .decs-head { display: flex; flex-direction: column; gap: 12px; }
  .dec { display: flex; flex-direction: column; gap: 12px; }
  .dec-head { display: flex; gap: 16px; align-items: baseline; }
  .dec-n { font-size: var(--t-h3); line-height: .9; letter-spacing: -.05em; color: var(--cobalt); }
  .dec-t { font-weight: 500; font-size: var(--t-h4); line-height: 1.05; letter-spacing: -.03em; }
  .dec-shot { position: relative; aspect-ratio: 16 / 10; border-radius: var(--r-card); overflow: hidden; display: flex; }
  .pin { position: absolute; width: 34px; height: 34px; margin: -17px 0 0 -17px; border-radius: var(--r-dot); display: flex; align-items: center; justify-content: center; background: var(--ink); color: var(--white); font-weight: 500; font-size: var(--t-small); box-shadow: 0 0 0 4px var(--white), 0 8px 20px var(--shadow-ink); pointer-events: none; }
  .dec-notes { display: grid; grid-template-columns: repeat(var(--cols), minmax(0, 1fr)); gap: 8px; }
  @media (max-width: 639px) { .dec-notes { grid-template-columns: minmax(0, 1fr); } }
  .dec-notes > div { display: flex; flex-direction: column; gap: 8px; padding: 16px; border-radius: var(--r-inner); background: var(--grey-238); }
  .dec-v { font-size: var(--t-body); line-height: 1.45; }

  /* Journey */
  .journey { gap: 24px; padding: var(--panel-pad); border-radius: var(--r-surface); background: var(--cobalt); color: var(--white); }
  .j-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; flex-wrap: wrap; }
  .j-title { display: flex; flex-direction: column; gap: 12px; }
  .j-ctrl { display: flex; gap: 8px; }
  .j-ctrl :global(.btn) { font-weight: 400; padding: 0 18px; }
  .j-arr { box-shadow: var(--ring-15) var(--on-dark-ring); }
  .j-arr[aria-disabled='true'] { opacity: .4; cursor: default; }
  .j-arr.fwd { background: var(--white); color: var(--cobalt); box-shadow: none; }
  .j-stations { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 6px; }
  .j-st { display: flex; flex-direction: column; align-items: flex-start; gap: 12px; text-align: left; }
  .j-st i { display: block; width: 100%; height: 44px; border-radius: var(--r-tile); background: var(--on-dark-line); transition: background var(--d-base) var(--ease); }
  .j-st.lit i { background: var(--white); }
  .j-st > span { display: flex; gap: 8px; align-items: baseline; }
  .j-st-t { font-size: var(--t-body); font-weight: 500; }
  .j-screen { position: relative; aspect-ratio: 16 / 9; min-height: 220px; border-radius: var(--r-inner); overflow: hidden; display: flex; background: var(--on-dark-fill); }
  .j-shot { flex: 1; display: flex; }
  .j-end { position: absolute; right: 16px; bottom: 16px; display: flex; align-items: baseline; gap: 8px; padding: 12px 18px; border-radius: var(--r-inner); background: var(--white); color: var(--cobalt); }
  .j-end-n { font-size: var(--t-h4); line-height: .9; letter-spacing: -.05em; }
  .j-end-w { font-size: var(--t-small); }

  /* Explored */
  .expl { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  @media (max-width: 639px) { .expl { grid-template-columns: minmax(0, 1fr); } }
  .expl-img { position: relative; min-height: 280px; border-radius: var(--r-card); overflow: hidden; display: flex; }
  .expl-grey { flex: 1; display: flex; filter: grayscale(1); opacity: .6; }
  .expl-strike { position: absolute; left: 50%; top: 50%; width: 140%; height: 6px; background: var(--orange); transform: translate(-50%, -50%) rotate(-20deg); pointer-events: none; }
  .expl-t { display: flex; flex-direction: column; justify-content: space-between; gap: 24px; padding: var(--panel-pad); border-radius: var(--r-card); background: var(--grey-238); }

  /* Result */
  .res-panel { display: flex; flex-direction: column; gap: clamp(18px, 2vw, 30px); padding: var(--panel-pad); border-radius: var(--r-surface); background: var(--ink); color: var(--white); }
  .res-top { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .res-how { padding: 4px 10px; border-radius: var(--r-pill); font-size: var(--t-label); box-shadow: inset 0 0 0 1px var(--orange); }
  .res-big { display: flex; align-items: flex-end; gap: 12px 32px; flex-wrap: wrap; }
  .res-n { display: block; font-size: var(--t-number-xl); line-height: .82; letter-spacing: -.085em; }
  .res-unit { font-size: .3em; letter-spacing: -.045em; }
  .res-l { font-size: var(--t-h4); font-weight: 500; line-height: 1; letter-spacing: -.03em; padding-bottom: .2em; }
  .res-mins { display: grid; grid-template-columns: repeat(var(--n), minmax(0, 1fr)); gap: 16px; }
  @media (max-width: 639px) { .res-mins { gap: 6px; } }
  .res-mins i { height: clamp(36px, 4vw, 56px); border-radius: var(--r-tile); background: var(--on-dark-fill); transition: background var(--d-base) var(--ease); }
  .res-mins i.on { background: var(--periwinkle); }
  .res-extra { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  @media (max-width: 639px) { .res-extra { grid-template-columns: minmax(0, 1fr); } }
  .res-extra > div { display: flex; flex-direction: column; gap: 6px; padding: 20px 22px; border-radius: var(--r-card); background: var(--cobalt); color: var(--white); }
  .res-extra .num { font-size: var(--t-h4); line-height: 1; }
  .res-extra .mist { font-size: var(--t-small); }
  .lesson { display: flex; flex-direction: column; gap: 12px; padding: 22px 24px; border-radius: var(--r-card); background: var(--peach); }
  .lesson p { font-size: var(--t-h5); line-height: 1.2; }
  .next { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; padding: 20px 24px; border-radius: var(--r-card); background: var(--grey-238); color: var(--ink); text-decoration: none; transition: box-shadow var(--d-fast) var(--ease); }
  .next:hover { box-shadow: var(--shadow-lift); color: var(--ink); }
  .next-l { display: flex; flex-direction: column; gap: 4px; }
  .next-r { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .next-n { font-size: var(--t-h4); letter-spacing: -.045em; }
  .next-r :global(.next-ten) { width: 136px; }
  .next-w { font-size: var(--t-small); }
</style>

<script>
  const main = document.querySelector<HTMLElement>('[data-case]')!;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Short · 1 min / Full · 5 min: Short hides research, explored and notes, and renumbers chapters.
  const ids = ['problem', 'research', 'decisions', 'journey', 'explored', 'result'];
  const setDepth = (d: string) => {
    main.dataset.depth = d;
    document.querySelectorAll('[data-depth-pick]').forEach((b) => b.setAttribute('aria-selected', String((b as HTMLElement).dataset.depthPick === d)));
    const live = ids.filter((id) => { const el = document.getElementById(id); return el && getComputedStyle(el).display !== 'none'; });
    document.querySelectorAll<HTMLElement>('[data-chap-n]').forEach((el) => {
      const k = live.indexOf(el.dataset.chapN!);
      if (k >= 0) el.textContent = String(k + 1).padStart(2, '0');
    });
  };
  document.addEventListener('click', (e) => { const b = (e.target as HTMLElement).closest<HTMLElement>('[data-depth-pick]'); if (b) setDepth(b.dataset.depthPick!); });
  setDepth('full');

  // Active chapter (rail highlight, auto-play only while in view) and the result counter.
  let active = 'problem';
  const rail = [...document.querySelectorAll<HTMLElement>('[data-rail-link]')];
  const io = new IntersectionObserver((es) => es.forEach((e) => {
    if (!e.isIntersecting) return;
    active = e.target.id;
    rail.forEach((a) => a.classList.toggle('on', a.dataset.railLink === active));
    if (active === 'result') count();
  }), { rootMargin: '-35% 0px -50% 0px' });
  ids.forEach((id) => { const el = document.getElementById(id); if (el) io.observe(el); });

  // Problem: Before / After, auto-toggles every 2.6s while in view until touched.
  const dia = document.querySelector<HTMLElement>('[data-dia]')!;
  const baBtns = [...document.querySelectorAll<HTMLButtonElement>('[data-ba]')];
  let after = false, touched = false;
  const setAfter = (v: boolean) => {
    after = v;
    dia.classList.toggle('after', v);
    baBtns.forEach((b) => b.setAttribute('aria-selected', String((b.dataset.ba === '1') === v)));
    dia.querySelector('[data-order]')!.textContent = v ? 'One order timeline' : '1 order';
    dia.querySelector('[data-legend]')!.textContent = v ? 'ONE SHARED VIEW' : 'LOST CONTEXT';
    dia.setAttribute('aria-label', v ? 'After: one order timeline connects three web apps and a mobile app' : 'Before: one order spread across three web apps and a mobile app, with lost context between them');
  };
  baBtns.forEach((b) => b.addEventListener('click', () => { touched = true; setAfter(b.dataset.ba === '1'); }));

  // Journey: four stops, Play/Pause, prev/next, auto-advance while in view.
  const stations = [...document.querySelectorAll<HTMLButtonElement>('[data-station]')];
  const shots = [...document.querySelectorAll<HTMLElement>('[data-shot]')];
  const playBtn = document.querySelector<HTMLButtonElement>('[data-play]')!;
  const prevBtn = document.querySelector<HTMLButtonElement>('[data-step-prev]')!;
  const nextBtn = document.querySelector<HTMLButtonElement>('[data-step-next]')!;
  const endChip = document.querySelector<HTMLElement>('[data-j-end]')!;
  const last = stations.length - 1;
  let step = 0, playing = !reduce;
  const setStep = (s: number) => {
    step = s;
    stations.forEach((b, i) => { b.classList.toggle('lit', i <= s); b.setAttribute('aria-pressed', String(i === s)); });
    shots.forEach((el, i) => { el.hidden = i !== s; });
    endChip.hidden = s !== last;
    prevBtn.setAttribute('aria-disabled', String(s === 0));
    nextBtn.setAttribute('aria-disabled', String(s === last));
  };
  const setPlaying = (p: boolean) => { playing = p; playBtn.textContent = p ? 'Pause' : 'Play'; };
  stations.forEach((b, i) => b.addEventListener('click', () => { setPlaying(false); setStep(i); }));
  prevBtn.addEventListener('click', () => { setPlaying(false); setStep(Math.max(0, step - 1)); });
  nextBtn.addEventListener('click', () => { setPlaying(false); setStep(Math.min(last, step + 1)); });
  playBtn.addEventListener('click', () => setPlaying(!playing));
  setStep(0);
  setPlaying(playing);

  if (!reduce) setInterval(() => {
    if (active === 'problem' && !touched) setAfter(!after);
    if (active === 'journey' && playing) setStep(step >= last ? 0 : step + 1);
  }, 2600);

  // Result: counter 0 → N over 1.4s, minute blocks fill along.
  const res = document.querySelector<HTMLElement>('[data-result]')!;
  const N = +res.dataset.result!;
  const counter = res.querySelector<HTMLElement>('[data-counter]')!;
  const mins = [...res.querySelectorAll<HTMLElement>('.res-mins i')];
  let counted = false;
  const paint = (v: number) => { counter.textContent = String(v); mins.forEach((m, i) => m.classList.toggle('on', i < v)); };
  function count() {
    if (counted) return;
    counted = true;
    if (reduce) return paint(N);
    let t0 = 0;
    const f = (ts: number) => { if (!t0) t0 = ts; const k = Math.min(1, (ts - t0) / 1400); paint(Math.round(N * (1 - Math.pow(1 - k, 3)))); if (k < 1) requestAnimationFrame(f); };
    requestAnimationFrame(f);
  }
</script>
