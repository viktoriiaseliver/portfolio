---
// Self-hosted fonts (no request to Google): Instrument Sans 400/500, Instrument Serif italic, Arimo 700.
import '@fontsource/instrument-sans/400.css';
import '@fontsource/instrument-sans/500.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource/arimo/700.css';
import sans500 from '@fontsource/instrument-sans/files/instrument-sans-latin-500-normal.woff2?url';
import sans400 from '@fontsource/instrument-sans/files/instrument-sans-latin-400-normal.woff2?url';
import '../styles/global.css';
import Nav from '../components/organisms/Nav.astro';
import { HIDE_FROM_SEARCH } from '../data/site';

interface Props {
  title: string;
  description: string;
  nav: { href: string; label: string; active?: boolean }[];
  cta?: { label: string; href: string };
  progress?: boolean;
  depth?: boolean;
  og?: string;   // file name in public/og/, 1200×630
}
const { title, description, nav, cta, progress, depth, og = 'site.png' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(`${base}/og/${og}`, Astro.site).href;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  {HIDE_FROM_SEARCH && <meta name="robots" content="noindex, nofollow" />}
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:site_name" content="Viktoriia Seliverstova" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
  {!HIDE_FROM_SEARCH && <link rel="sitemap" href={`${base}/sitemap.xml`} />}
  <meta name="theme-color" content="#181d28" />
  <slot name="head" />
  <link rel="preload" href={sans500} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={sans400} as="font" type="font/woff2" crossorigin />
</head>
<body>
  <Nav links={nav} cta={cta} progress={progress} depth={depth} />
  <slot />
</body>
</html>
