---
import '../styles/global.css';
import Nav from '../components/organisms/Nav.astro';

interface Props {
  title: string;
  description: string;
  nav: { href: string; label: string; active?: boolean }[];
  cta?: { label: string; href: string };
  progress?: boolean;
  depth?: boolean;
}
const { title, description, nav, cta, progress, depth } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta name="theme-color" content="#181d28" />
  <slot name="head" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500&family=Instrument+Serif:ital@1&family=Arimo:wght@700&display=swap" />
</head>
<body>
  <Nav links={nav} cta={cta} progress={progress} depth={depth} />
  <slot />
</body>
</html>
