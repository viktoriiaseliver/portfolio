---
// Level C case: header, passport, 2–3 sentences, 4–6 screens with captions, next.
import Base from './Base.astro';
import Contact from '../components/organisms/Contact.astro';
import NextCase from '../components/organisms/NextCase.astro';
import Chip from '../components/atoms/Chip.astro';
import Slot from '../components/atoms/Slot.astro';
import Ph from '../components/atoms/Ph.astro';
import Heading from '../components/atoms/Heading.astro';
import Panel from '../components/molecules/Panel.astro';
import Facts from '../components/molecules/Facts.astro';
import { filled, visible } from '../lib/placeholder';
import type { ShortCase } from '../cases/types';

interface Props { c: ShortCase }
const { c } = Astro.props;
const nav = [{ href: '/#work', label: 'Proof' }, { href: '/works', label: 'All work' }, { href: '/about', label: 'About' }];
const text = c.text.filter(visible);
const screens = c.screens;
// Even number of screens keeps the 2-column grid free of a lone cell; an odd count lets the first one span.
const spanFirst = screens.length % 2 === 1;
---
<Base title={`${c.title.a}${c.title.b} — Viktoriia Seliverstova`} description={c.text.find(filled) ?? c.industry} nav={nav}>
<main class="page casec">
  <Panel as="section" tone="dark" class="c-head">
    <div class="c-top"><Chip tone="brand" class="c-ind">{c.industry}</Chip><div class="c-tags">{c.tags.map((t) => <Chip tone="dark" size="s">{t}</Chip>)}</div></div>
    <Heading as="h1" size="display" a={c.title.a} b={c.title.b} bTone="mist" />
    <div class="c-body">
      <div class="c-text">{text.map((t) => <p class="lead mist"><Ph v={t} /></p>)}</div>
      <Facts items={c.facts} />
    </div>
  </Panel>

  <section class="block grid-2 c-screens">
    {screens.map((s, i) => (
      <figure class:list={['c-shot', { wide: spanFirst && i === 0 }]}>
        <div class="c-shot-img"><Slot label={s.ph} src={s.image} /></div>
        {visible(s.caption) && <figcaption class="small muted"><Ph v={s.caption} /></figcaption>}
      </figure>
    ))}
  </section>

  <NextCase next={c.next} />
  <Contact />
</main>
</Base>

<style>
  .casec :global(.c-head) { display: flex; flex-direction: column; gap: 32px; }
  .c-top { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }
  .casec :global(.c-ind) { padding: 10px 18px; font-size: var(--t-body); font-weight: 500; }
  .c-tags { display: flex; gap: 6px; flex-wrap: wrap; }
  .c-body { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 24px 48px; align-items: end; }
  @media (max-width: 899px) { .c-body { grid-template-columns: minmax(0, 1fr); } }
  .c-text { display: flex; flex-direction: column; gap: 8px; max-width: 62ch; }
  .c-shot { margin: 0; display: flex; flex-direction: column; gap: 10px; }
  .c-shot.wide { grid-column: 1 / -1; }
  .c-shot-img { aspect-ratio: 16 / 10; border-radius: var(--r-card); overflow: hidden; display: flex; }
  .c-shot figcaption { padding: 0 6px; }
  .casec :global(.next) { margin-top: var(--block-top); }
</style>
