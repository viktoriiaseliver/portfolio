<script>
  type Prev = { t: string; r: string; d: string; m: string; tags: string[]; img: string; href: string | null; ind: string };
  const PREV: Prev[] = JSON.parse(document.getElementById('work-data')!.textContent!);
  const main = document.querySelector<HTMLElement>('[data-work]')!;
  const $$ = <T extends Element = HTMLElement>(s: string, r: ParentNode = main) => [...r.querySelectorAll<T>(s)];
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
  const IND: Record<string, string> = {};
  $$('[data-ind-pick]', document).forEach((b) => { if (b.dataset.indPick) IND[b.dataset.indPick] = b.querySelector('.frow-l')!.textContent!; });

  const S = { section: 'all', ind: '', plat: '', gtype: '', view: 'rows', sel: -1, open: new Set<string>() };
  const q = new URLSearchParams(location.search).get('section');
  if (q && ['product', 'mine', 'graphic'].includes(q)) S.section = q;

  // One record per product, read once from the rows markup.
  const P = $$('.rows [data-p]').map((el) => ({ i: +el.dataset.p!, ind: el.dataset.ind!, plat: el.dataset.plat!.split(' ').filter(Boolean) }));
  const match = (p: (typeof P)[number], ind = S.ind, plat = S.plat) => (!ind || p.ind === ind) && (!plat || p.plat.includes(plat));
  const phone = matchMedia('(max-width: 639px)');

  function apply() {
    const showProduct = S.section === 'all' || S.section === 'product';
    const showMine = (S.section === 'all' || S.section === 'mine') && !S.ind && (!S.plat || S.plat === 'iOS');
    const showGraphic = (S.section === 'all' || S.section === 'graphic') && !S.ind && !S.plat;
    const vis = new Set(showProduct ? P.filter((p) => match(p)).map((p) => p.i) : []);
    main.dataset.section = S.section;
    main.dataset.view = S.view;
    main.dataset.plat = S.plat;

    $$('[data-p]').forEach((el) => { el.hidden = !vis.has(+el.dataset.p!); });

    // Groups: hide empty ones, renumber the rest, cap phone lists at 3.
    let gi = 0, run = 0;
    const live = $$('.group').filter((g) => $$('.rows [data-p]', g).some((el) => !el.hidden));
    const total = String(live.length).padStart(2, '0');
    $$('[data-group]').forEach((g) => {
      const count = P.filter((p) => p.ind === g.dataset.group && vis.has(p.i)).length;
      g.hidden = count === 0;
      if (count === 0) return;
      if (g.classList.contains('group')) gi++;
      $$('[data-group-no]', g).forEach((el) => { el.textContent = g.classList.contains('group') ? `${String(gi).padStart(2, '0')} / ${total}` : String(gi).padStart(2, '0'); });
      $$('[data-group-count]', g).forEach((el) => { el.textContent = String(count); });
      if (!g.classList.contains('group')) return;
      const capped = !S.open.has(g.dataset.group!) && count > 3;
      ['.mrow', '.card'].forEach((sel) => $$(sel, g).filter((el) => !el.hidden).forEach((el, k) => el.classList.toggle('capped', capped && k >= 3)));
      $$('.mrow', g).filter((el) => !el.hidden).forEach((el, k) => {
        run++;
        el.classList.toggle('sep', k > 0);
        const no = el.querySelector('[data-thumb-no]');
        if (no) no.textContent = String(run).padStart(2, '0');
      });
      const more = g.querySelector<HTMLElement>('[data-more]')!;
      more.hidden = !capped || S.view === 'index' && !phone.matches;
      more.querySelector('[data-more-n]')!.textContent = String(count - 3);
    });

    // Counts and filter controls
    const nShown = vis.size;
    const gShown = $$('[data-gtype-of]').filter((el) => { const on = showGraphic && (!S.gtype || el.dataset.gtypeOf === S.gtype); el.hidden = !on; return on; }).length;
    $$('[data-shown]').forEach((el) => { el.textContent = String(nShown + (showMine ? 5 : 0) + gShown); });
    $$('[data-count]', document).forEach((el) => { el.textContent = String(nShown); });
    $$('[data-noun]').forEach((el) => { el.textContent = nShown === 1 ? 'project' : 'projects'; });
    $$('[data-count-label]', document).forEach((el) => { el.textContent = nShown === 1 ? '1 project' : `${nShown} projects`; });
    const hasFilter = !!(S.ind || S.plat);
    $$('[data-clear]', document).forEach((el) => { el.hidden = !hasFilter; });
    const ddBtn = document.querySelector<HTMLElement>('[data-dd-btn]')!;
    ddBtn.classList.toggle('set', !!S.ind);
    document.querySelector('[data-ind-label]')!.textContent = S.ind ? IND[S.ind] : 'All';
    $$<HTMLButtonElement>('[data-ind-pick]', document).forEach((b) => {
      const k = b.dataset.indPick!;
      const n = P.filter((p) => (!k || p.ind === k) && (!S.plat || p.plat.includes(S.plat))).length;
      b.querySelector('.frow-n')!.textContent = String(n);
      b.setAttribute('aria-pressed', String(S.ind === k));
      b.disabled = !n && S.ind !== k;
    });
    $$<HTMLButtonElement>('[data-plat-pick]', document).forEach((b) => {
      const k = b.dataset.platPick!;
      const n = !k ? 1 : k === 'iOS' ? 3 : P.filter((p) => (!S.ind || p.ind === S.ind) && p.plat.includes(k)).length;
      b.setAttribute('aria-pressed', String(S.plat === k));
      b.disabled = !n && S.plat !== k;
    });
    $$('[data-view-pick]', document).forEach((b) => b.setAttribute('aria-pressed', String(S.view === b.dataset.viewPick)));
    $$('[data-section-tab]').forEach((b) => b.setAttribute('aria-selected', String(S.section === b.dataset.sectionTab)));
    const nf = (S.ind ? 1 : 0) + (S.plat ? 1 : 0);
    document.querySelector('[data-pill-label]')!.textContent = nf ? `Filter · ${nf}` : 'Filter';
    document.querySelector<HTMLElement>('[data-fpill]')!.hidden = !showProduct || !sheet.hidden;

    $$('[data-gtype]').forEach((b) => { const on = S.gtype === b.dataset.gtype; b.setAttribute('aria-pressed', String(on)); b.querySelector('i')!.textContent = on ? '×' : '+'; });
    main.querySelector<HTMLElement>('[data-mine]')!.hidden = !showMine;
    main.querySelector<HTMLElement>('[data-graphic]')!.hidden = !showGraphic;
    main.querySelector<HTMLElement>('[data-banner]')!.hidden = !(S.section === 'product' || (S.section === 'all' && !hasFilter));
    main.querySelector<HTMLElement>('[data-empty]')!.hidden = nShown + (showMine ? 5 : 0) + gShown > 0;

    const ca = main.querySelector('[data-contact-a]'), cb = main.querySelector('[data-contact-b]');
    if (ca && cb) {
      const g = S.section === 'graphic';
      ca.textContent = g ? 'Looking for a designer who can do both ' : 'Hiring for a senior ';
      cb.textContent = g ? 'product and visual?' : 'product role?';
    }
    renderIndex(vis);
  }

  // Index view: selected item (or the first visible) in the side panel.
  function renderIndex(vis: Set<number>) {
    const ids = $$('.ii').filter((el) => !el.hidden).map((el) => +el.dataset.p!);
    const sel = vis.has(S.sel) ? S.sel : ids[0];
    $$('.ii').forEach((el) => el.setAttribute('aria-pressed', String(+el.dataset.p! === sel)));
    const panel = main.querySelector<HTMLElement>('[data-ipanel]')!;
    if (sel == null) { panel.innerHTML = ''; return; }
    const p = PREV[sel];
    const head = p.img
      ? `<div class="ip-img" style="background-image:${p.img}"></div>`
      : `<div class="ip-big"><span class="label mist">${esc(p.ind)}</span><span class="num">${esc(p.r || p.t)}</span></div>`;
    const link = p.href ? `<a class="btn btn-white on-brand has-arr" href="${p.href}">View case<span class="arr" aria-hidden="true">→</span></a>` : '';
    panel.innerHTML = `${head}<div class="ip-b"><span class="ip-t">${esc(p.t)}</span>${p.r && p.img ? `<span class="num ip-r">${esc(p.r)}</span>` : ''}<span class="ip-d mist">${esc(p.d)}</span><span class="label-s on-ink-muted">${esc(p.m)}</span><div class="ip-foot"><div class="ip-tags">${p.tags.map((t) => `<span>${esc(t)}</span>`).join('')}</div>${link}</div></div>`;
  }

  // Sections reset filters and scroll to top; ?section= deep link.
  function go(section: string) {
    Object.assign(S, { section, ind: '', plat: '', gtype: '' });
    const u = new URL(location.href);
    if (section === 'all') u.searchParams.delete('section'); else u.searchParams.set('section', section);
    history.replaceState(null, '', u);
    apply();
    scrollTo({ top: 0, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
  }

  // Industry dropdown
  const ddBtn = document.querySelector<HTMLButtonElement>('[data-dd-btn]')!;
  const ddList = document.querySelector<HTMLElement>('[data-dd-list]')!;
  const ddScrim = document.querySelector<HTMLElement>('[data-dd-scrim]')!;
  const setDD = (open: boolean) => { ddList.hidden = !open; ddScrim.hidden = !open; ddBtn.setAttribute('aria-expanded', String(open)); };

  // Phone sheet
  const sheet = document.querySelector<HTMLElement>('[data-sheet]')!;
  const sheetPanel = sheet.querySelector<HTMLElement>('.sheet-panel')!;
  const pillBtn = document.querySelector<HTMLElement>('[data-sheet-open]')!;
  const setSheet = (open: boolean) => {
    sheet.hidden = !open;
    document.body.style.overflow = open ? 'hidden' : '';
    apply();
    // Focus moves into the sheet and comes back to the Filter button.
    if (open) sheetPanel.focus(); else pillBtn.focus();
  };
  // Keep Tab inside the open sheet.
  sheet.addEventListener('keydown', (e) => {
    if (e.key !== 'Tab') return;
    const f = [...sheet.querySelectorAll<HTMLElement>('button:not([disabled]):not([hidden])')].filter((el) => el.offsetParent && !el.classList.contains('sheet-scrim'));
    const first = f[0], last = f[f.length - 1];
    if (e.shiftKey && (document.activeElement === first || document.activeElement === sheetPanel)) { e.preventDefault(); last.focus(); }
    else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
  });

  document.addEventListener('click', (e) => {
    const t = (e.target as HTMLElement).closest<HTMLElement>('button');
    if (!t) return;
    const d = t.dataset;
    if (d.sectionTab) go(d.sectionTab);
    else if (d.to) go(d.to);
    else if ('ddBtn' in d) setDD(ddList.hidden);
    else if ('ddScrim' in d) setDD(false);
    else if (d.indPick !== undefined) { S.ind = d.indPick; setDD(false); apply(); }
    else if (d.platPick !== undefined) { const k = d.platPick; S.plat = S.plat === k ? '' : k; if (k === 'iOS') S.ind = ''; apply(); }
    else if (d.viewPick) { S.view = d.viewPick; apply(); }
    else if ('clear' in d || 'clearAll' in d) { Object.assign(S, { ind: '', plat: '', gtype: '' }); apply(); }
    else if ('sheetOpen' in d) setSheet(true);
    else if ('sheetClose' in d) setSheet(false);
    else if ('more' in d) { S.open.add(t.closest<HTMLElement>('[data-group]')!.dataset.group!); apply(); }
    else if (d.gtype) { S.gtype = S.gtype === d.gtype ? '' : d.gtype; apply(); }
    else if (d.select) { S.sel = +d.select; renderIndex(new Set(P.filter((p) => match(p)).map((p) => p.i))); }
  });
  $$('.ii').forEach((b) => ['mouseenter', 'focus'].forEach((ev) => b.addEventListener(ev, () => { S.sel = +b.dataset.p!; renderIndex(new Set(P.filter((p) => match(p)).map((p) => p.i))); })));
  addEventListener('keydown', (e) => { if (e.key === 'Escape') { setDD(false); if (!sheet.hidden) setSheet(false); } });

  // Floating cover preview that follows the cursor over rows (fine pointers only).
  const float = main.querySelector<HTMLElement>('[data-float]')!;
  const fine = matchMedia('(hover: hover) and (pointer: fine)');
  let raf = 0;
  const place = (x: number, y: number) => {
    float.style.left = x + 'px';
    float.style.top = y + 'px';
    float.style.transform = `translate(${x > innerWidth - 420 ? 'calc(-100% - 36px)' : '36px'},-50%) rotate(-3deg)`;
  };
  $$('.row').forEach((row) => {
    row.addEventListener('mouseenter', (e) => {
      if (!fine.matches || phone.matches) return;
      const p = PREV[+row.dataset.p!];
      float.innerHTML = p.img
        ? `<div class="fl-img" style="background-image:${p.img}"></div>`
        : `<div class="fl-big"><span class="label mist">${esc(p.ind)}</span><span class="num">${esc(p.r || p.t)}</span><span class="fl-d mist">${esc(p.d)}</span></div>`;
      place(e.clientX, e.clientY);
      float.hidden = false;
    });
    row.addEventListener('mousemove', (e) => { cancelAnimationFrame(raf); raf = requestAnimationFrame(() => place(e.clientX, e.clientY)); });
    row.addEventListener('mouseleave', () => { float.hidden = true; });
  });
  addEventListener('scroll', () => { float.hidden = true; }, { passive: true });

  phone.addEventListener('change', () => { if (!phone.matches && !sheet.hidden) setSheet(false); apply(); });
  apply();
</script>
