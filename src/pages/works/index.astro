---
import Base from '../../layouts/Base.astro';
import Contact from '../../components/organisms/Contact.astro';
import Slot from '../../components/atoms/Slot.astro';
import Button from '../../components/atoms/Button.astro';
import Chip from '../../components/atoms/Chip.astro';
import Badge from '../../components/atoms/Badge.astro';
import Dot from '../../components/atoms/Dot.astro';
import Heading from '../../components/atoms/Heading.astro';
import Phone from '../../components/atoms/Phone.astro';
import Segmented from '../../components/atoms/Segmented.astro';
import Panel from '../../components/molecules/Panel.astro';
import { url, bg } from '../../lib/url';
import Illustration from '../../components/atoms/Illustration.astro';
import { industryScenes } from '../../data/illustrations';
import { published as aiPublished } from '../../data/ai';
import { industries, products, apps, stack, ai, graphicTypes, graphics, visualProducts, sections, LIVE_CASES, OLD_CASES } from '../../data/work';

const nav = [{ href: '/#work', label: 'Proof' }, { href: '/works', label: 'All work', active: true }, { href: '/about', label: 'About' }];
const pad = (n: number) => String(n).padStart(2, '0');
const plats = (p: (typeof products)[number]) => p.tags.filter((t) => t === 'Web' || t === 'Mobile');
const shortMeta = (m: string) => { const parts = m.split(' · '); return parts[0] + ' · ' + parts[parts.length - 1]; };
// New case page first, then the old portfolio case, otherwise no link.
const hrefOf = (p: (typeof products)[number]) => (LIVE_CASES.includes(p.slug) ? url('/work/' + p.slug) : OLD_CASES[p.slug] ?? null);

const items = products.map((p, i) => ({ ...p, i, plat: plats(p).join(' '), href: hrefOf(p), short: shortMeta(p.m) }));
const groups = industries.map((g) => ({ ...g, items: items.filter((p) => p.ind === g.key) }));
const preview = items.map((p) => ({ t: p.t, r: p.r, d: p.d, m: p.m, tags: p.tags, img: p.img ? bg(p.img) : '', href: p.href, ind: industries.find((x) => x.key === p.ind)!.label.toUpperCase() }));
const Arrow = '→';
const platItems = (pills: string[]) => pills.map((p) => ({ label: p, attrs: { 'data-plat-pick': p === 'All' ? '' : p } }));
const viewItems = (views: string[][]) => views.map(([k, l]) => ({ label: l, attrs: { 'data-view-pick': k }, class: k === 'index' ? 'only-d' : undefined }));
---
<Base og="works.png" title="Work — Viktoriia Seliverstova" description="25 products I designed for companies in 7 industries, 5 apps I build on my own, and the graphic work behind them." nav={nav}>
<main id="top" class="page work g12" data-work data-section="all" data-view="rows">

  <section class="console g12">
    <h1 class="console-h">Work</h1>
    <div class="console-count" aria-live="polite">
      <div class="console-count-n"><span class="num" data-shown>44</span><span class="serif mist">/ 44</span></div>
      <span class="label mist">PROJECTS SHOWN</span>
    </div>
    <p class="console-lead">25 products I designed for companies in 7 industries, 5 apps I build on my own, and the graphic work behind them.</p>
    <div class="tabs" role="tablist" aria-label="Section">
      {sections.map(([k, label, n]) => <button type="button" role="tab" class="tab" data-section-tab={k} aria-selected={k === 'all' ? 'true' : 'false'}><span>{label}</span><Badge tone="on-dark" class="tab-n">{n}</Badge></button>)}
    </div>
  </section>

  <!-- Filter bar: desktop and tablet -->
  <div class="fbar-wrap only-product">
    <div class="fbar">
      <div class="dd">
        <button type="button" class="dd-btn" aria-expanded="false" aria-haspopup="listbox" data-dd-btn><span class="dd-k">Industry</span><span data-ind-label>All</span><i class="chev" aria-hidden="true"></i></button>
        <div class="dd-list" role="listbox" hidden data-dd-list>
          <button type="button" class="frow" data-ind-pick=""><span class="fdot" aria-hidden="true"></span><span class="frow-l">All industries</span><span class="num frow-n"></span></button>
          {industries.map((g) => <button type="button" class="frow" data-ind-pick={g.key}><span class="fdot" aria-hidden="true"></span><span class="frow-l">{g.label}</span><span class="num frow-n"></span></button>)}
        </div>
      </div>
      <Segmented items={platItems(['All', 'Web', 'Mobile', 'iOS'])} label="Platform" />
      <span class="fbar-sp"></span>
      <span class="fbar-count muted" aria-live="polite"><b class="num" data-count>25</b> <span data-noun>projects</span></span>
      <Button variant="text" data-clear hidden>Clear</Button>
      <Segmented items={viewItems([['rows', 'Rows'], ['index', 'Index'], ['cards', 'Cards']])} label="View" />
    </div>
  </div>
  <button type="button" class="dd-scrim" aria-label="Close" hidden data-dd-scrim></button>

  <!-- Filters: phone -->
  <div class="fpill-wrap" data-fpill hidden>
    <div class="fpill">
      <button type="button" class="fpill-btn" data-sheet-open><span class="fpill-ic" aria-hidden="true"><i></i><i></i><i></i></span><span data-pill-label>Filter</span></button>
      <b class="num fpill-n" data-count>25</b>
    </div>
  </div>
  <div class="sheet" role="dialog" aria-modal="true" aria-label="Filters" hidden data-sheet>
    <button type="button" class="sheet-scrim" aria-label="Close filters" data-sheet-close></button>
    <div class="sheet-panel" tabindex="-1">
      <div class="sheet-grab"><i></i></div>
      <div class="sheet-head"><span class="sheet-title">Filter</span><Button variant="text" data-clear hidden>Clear all</Button></div>
      <div class="sheet-body">
        <div class="sheet-grp"><span class="label muted">VIEW</span><Segmented items={viewItems([['rows', 'Rows'], ['cards', 'Cards']])} label="View" class="full" /></div>
        <div class="sheet-grp"><span class="label muted">PLATFORM</span><Segmented items={platItems(['All', 'Web', 'Mobile', 'iOS'])} label="Platform" class="full" /></div>
        <div class="sheet-grp"><span class="label muted">INDUSTRY</span>
          <div class="sheet-list">
            <button type="button" class="frow" data-ind-pick=""><span class="fdot" aria-hidden="true"></span><span class="frow-l">All industries</span><span class="num frow-n"></span></button>
            {industries.map((g) => <button type="button" class="frow" data-ind-pick={g.key}><span class="fdot" aria-hidden="true"></span><span class="frow-l">{g.label}</span><span class="num frow-n"></span></button>)}
          </div>
        </div>
      </div>
      <div class="sheet-foot"><button type="button" class="sheet-show" data-sheet-close>Show <span data-count-label>25 projects</span></button></div>
    </div>
  </div>

  <section class="empty" hidden data-empty>
    <span class="h2">Nothing here yet.</span>
    <Button variant="ink" data-clear-all>Clear filters</Button>
  </section>

  <!-- Product work, grouped by industry -->
  {groups.map((g) => (
    <section class="group g12 only-product" data-group={g.key}>
      <header class="group-h">
        <div class="group-top"><span class="label-s group-no" data-group-no></span><Badge data-group-count>{g.items.length}</Badge></div>
        <h2 class="group-t">{g.label}</h2>
        <p class="group-sub muted">{g.sub}</p>
        {industryScenes[g.key] && <Illustration src={industryScenes[g.key].src} label={industryScenes[g.key].label} ratio="4 / 3" class="group-scene" />}
      </header>
      <div class="rows">
        {g.items.map((p) => {
          const Tag = p.href ? 'a' : 'div';
          return (
            <Tag class="row" href={p.href ?? undefined} data-p={p.i} data-ind={p.ind} data-plat={p.plat} tabindex={p.href ? undefined : 0}>
              <div class="row-t"><span class="row-title">{p.t}</span><span class="label-s row-m">{p.m}</span></div>
              <span class="num row-r">{p.r}</span>
              <span class="row-arr" aria-hidden="true">{Arrow}</span>
            </Tag>
          );
        })}
      </div>
      <div class="mrows">
        {g.items.map((p, idx) => {
          const Tag = p.href ? 'a' : 'div';
          return (
            <Tag class="mrow" href={p.href ?? undefined} data-p={p.i} data-ind={p.ind} data-plat={p.plat}>
              <span class:list={['mthumb', { alt: idx % 2 === 1 }]} style={p.img ? `background-image:${bg(p.img)}` : undefined}>{!p.img && <span data-thumb-no></span>}</span>
              <span class="mrow-b"><span class="mrow-txt"><span class="mrow-t">{p.t}</span>{p.r && <span class="num mrow-r">{p.r}</span>}<span class="muted mrow-m">{p.short}</span></span><i class="mchev" aria-hidden="true"></i></span>
            </Tag>
          );
        })}
      </div>
      <div class="cards">
        {g.items.map((p) => {
          const Tag = p.href ? 'a' : 'div';
          return (
            <Tag class:list={['card', { dark: !!p.img }]} href={p.href ?? undefined} data-p={p.i} data-ind={p.ind} data-plat={p.plat}>
              {p.href && <span class="card-arr" aria-hidden="true">{Arrow}</span>}
              {p.img && <div class="card-img" style={`background-image:${bg(p.img)}`}></div>}
              <div class="card-b">
                {p.r && <span class="num card-r">{p.r}</span>}
                <div class="card-tt"><span class="card-t">{p.t}</span><span class="card-d">{p.d}</span></div>
                <div class="card-foot"><span class="label-s card-m">{p.m}</span><div class="card-tags">{p.tags.map((t) => <Chip tone={p.img ? 'dark' : 'white'} size="s" class="tag">{t}</Chip>)}</div></div>
              </div>
            </Tag>
          );
        })}
      </div>
      <button type="button" class="more" data-more hidden>Show <span data-more-n></span> more<span aria-hidden="true">↓</span></button>
    </section>
  ))}

  <!-- Index view (desktop only) -->
  <section class="index only-product">
    <div class="index-list">
      {groups.map((g) => (
        <div class="ig" data-group={g.key}>
          <div class="ig-h"><span class="ig-ht"><span class="label-s group-no" data-group-no></span><span class="ig-t">{g.label}</span></span><span class="serif ig-n">(<span data-group-count>{g.items.length}</span>)</span></div>
          {g.items.map((p) => <button type="button" class="ii" data-p={p.i} data-ind={p.ind} data-plat={p.plat} data-select={p.i}><span class="ii-t">{p.t}</span><span class="ii-r"><span class="num">{p.r}</span><span class="ii-arr" aria-hidden="true">{Arrow}</span></span></button>)}
        </div>
      ))}
    </div>
    <aside class="ipanel" aria-live="polite" data-ipanel></aside>
  </section>

  <div class="float" aria-hidden="true" hidden data-float></div>

  <button type="button" class="banner" data-to="mine" data-banner>
    <span class="h5 banner-t">I also build my own products — from the first sketch to the App Store.</span>
    <span class="btn btn-white has-arr">See My products<span class="arr" aria-hidden="true">{Arrow}</span></span>
  </button>

  <!-- My products -->
  <section id="mine" class="section g12 mine" data-mine>
    <Heading size="display" a="My " b="products" class="big-h s-half" />
    <div class="s-half mine-intro">
      <p class="muted body">I build small, focused apps on my own: the idea, the design, the SwiftUI code with Claude Code and Cursor, and the App Store page. Every decision is mine to defend and every bug is mine to fix — that is the best product school I know.</p>
      <div class="pills">{stack.map((x) => <Chip tone="soft" size="s" class="pill-s">{x}</Chip>)}</div>
    </div>
    {apps.map((a) => (
      <Panel as="article" tone="dark" class="appcard g12">
        <div class="s-phone appcard-ph"><Phone label={a.ph} /></div>
        <div class="s-apptext appcard-t">
          <div class="appcard-head">
            <Chip tone="dark" size="s" class="tag-status"><Dot tone="orange" size={7} />{a.status}</Chip>
            <h3 class="display big-h">{a.name}</h3>
            <span class="serif slogan mist">{a.slogan}</span>
            <p class="body mist">{a.d}</p>
          </div>
          <div class="dec"><span class="label on-ink-muted">DECISIONS I MADE</span>{a.dec.map((t, i) => <div class="dec-row"><span class="num dec-n">0{i + 1}</span><span>{t}</span></div>)}</div>
          <div class="did"><span class="label on-ink-muted">WHAT I DID</span>{a.did.map((w) => <Chip tone="dark">{w}</Chip>)}</div>
          {a.page && <Button href={url(a.page)} variant="white" arrow>Open product page</Button>}
        </div>
      </Panel>
    ))}
    <Panel as="article" tone="soft" class="s-half kvit" data-not-ios>
      <Chip tone="white" size="s" class="tag-status">CONCEPT</Chip>
      <div class="kvit-h"><h3 class="display big-h">Kvit</h3><span class="serif slogan muted">Receipts, grocery prices and a food budget in one place.</span></div>
      <div class="did"><span class="label muted">WHAT I DID</span><Chip tone="white">Idea</Chip><Chip tone="white">research</Chip><Chip tone="white">product design</Chip></div>
    </Panel>
    <Panel as="article" tone="brand" class="s-half aicard" data-not-ios>
      <Chip tone="dark" size="s" class="tag-status"><Dot tone="green" size={7} />IN DAILY USE</Chip>
      <div class="kvit-h"><Heading as="h3" size="h3" a="How I work " b="with AI" class="ai-h" /><p class="body mist">My everyday setup: a system of AI agents with rules I wrote and keep improving.</p></div>
      <div class="ai-grid">{ai.map((x) => <div class="ai-item"><span class="ai-t">{x.t}</span><span class="mist ai-d">{x.d}</span></div>)}</div>
      {aiPublished && <Button href={url('/ai')} variant="white" onBrand arrow class="ai-more">How I work with AI</Button>}
    </Panel>
  </section>

  <!-- Graphic & illustration -->
  <section id="graphic" class="section g12 graphic" data-graphic>
    <Heading size="display" a="Graphic & " b="illustration" class="big-h s-half" />
    <p class="s-half muted body graphic-p">Brand systems, illustration, print and icons. 14 projects, plus product work where the visual side carried the result.</p>
    <div class="gtypes">
      <span class="label muted gtypes-k">TYPE</span>
      {graphicTypes.map(([label, n]) => <button type="button" class="gchip" aria-pressed="false" data-gtype={label}>{label}<span class="num gchip-n">{n}</span><i aria-hidden="true">+</i></button>)}
    </div>
    {graphics.map((g) => (
      <div class="gtile s-gfx" data-gtype-of={g.type}>
        <div class="gtile-img"><Slot label={g.t} /></div>
        <div class="gtile-t"><span class="label" style="color:var(--cobalt)">{g.type}</span><span class="gtile-name">{g.t}</span><span class="muted gtile-l">{g.l}</span></div>
      </div>
    ))}
    <div class="vis">
      <div class="vis-l"><span class="vis-t">Product work with a strong visual side</span><div class="pills">{visualProducts.map((x) => <Chip tone="soft">{x}</Chip>)}</div></div>
      <Button variant="ink" arrow data-to="product">All product work</Button>
    </div>
  </section>

  <div class="full"><Contact /></div>
</main>
<script type="application/json" id="work-data" set:html={JSON.stringify(preview)}></script>
</Base>

<style>
  /* 12-col grid: 12 / 12 / 4 columns at desktop / tablet / phone */
  .g12 { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 24px; }
  .work { padding-bottom: 16px; row-gap: 12px; }
  .work > *, .full { grid-column: 1 / -1; min-width: 0; }
  .s-half { grid-column: span 6; }
  .s-phone { grid-column: span 4; }
  .s-apptext { grid-column: span 8; }
  .s-gfx { grid-column: span 3; }
  @media (max-width: 1099px) { .s-half { grid-column: span 12; } .s-phone { grid-column: span 5; } .s-apptext { grid-column: span 7; } .s-gfx { grid-column: span 4; } }
  @media (max-width: 639px) {
    .g12 { grid-template-columns: repeat(4, minmax(0, 1fr)); column-gap: 16px; }
    .s-half, .s-phone, .s-apptext { grid-column: span 4; }
    .s-gfx { grid-column: span 2; }
  }
  .body { font-size: var(--t-body); line-height: 1.5; max-width: 62ch; }
  .big-h { line-height: .86; }
  .pills { display: flex; gap: 4px; flex-wrap: wrap; }
  .pills :global(.pill-s) { letter-spacing: 0; }

  /* Section visibility */
  .work:not([data-section='all']):not([data-section='product']) .only-product { display: none !important; }
  [hidden] { display: none !important; }

  /* Console */
  .console { border-radius: var(--r-surface); background: var(--cobalt); color: var(--white); padding: var(--panel-pad); row-gap: clamp(22px, 3.6vw, 56px); }
  .console-h { grid-column: span 8; align-self: end; font-weight: 500; font-size: var(--t-number-xl); line-height: .78; letter-spacing: -.055em; }
  .console-count { grid-column: span 4; align-self: end; display: flex; flex-direction: column; align-items: flex-end; gap: 8px; }
  .console-count-n { display: flex; align-items: baseline; gap: 8px; }
  .console-count-n .num { font-size: var(--t-hero); line-height: .8; letter-spacing: -.055em; }
  .console-count-n .serif { font-size: var(--t-h5); }
  .console-lead { grid-column: span 7; font-size: var(--t-h5); line-height: 1.3; letter-spacing: -.02em; font-weight: 400; }
  .tabs { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 6px; padding: 6px; border-radius: var(--r-card); background: var(--on-dark-fill); }
  .tab { display: flex; justify-content: flex-start; align-items: center; gap: 12px; min-height: 52px; padding: 0 18px; border-radius: var(--r-inner); font-size: var(--t-body); font-weight: 500; text-align: left; color: var(--white); transition: background var(--d-base) var(--ease), color var(--d-base) var(--ease); }
  .tab:hover { box-shadow: inset 0 0 0 1.5px var(--on-dark-glass); }
  .tab[aria-selected='true'] { background: var(--white); color: var(--cobalt); }
  .tab-n { transition: background var(--d-base) var(--ease); }
  .tab[aria-selected='true'] :global(.tab-n) { background: var(--cobalt); }
  @media (max-width: 1099px) { .console-h { grid-column: span 7; } .console-count { grid-column: span 5; } .console-lead { grid-column: span 10; } }
  @media (max-width: 639px) {
    .console-h, .console-count, .console-lead { grid-column: span 4; }
    .console-count { align-items: flex-start; }
    .tabs { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  /* Filter bar */
  .fbar-wrap { position: sticky; top: 72px; z-index: 40; transition: top var(--d-base) var(--ease); }
  :global(html.nav-hidden) .fbar-wrap { top: 10px; }
  @media (max-width: 639px) { .fbar-wrap { display: none !important; } }
  .fbar { display: flex; align-items: center; gap: 8px; padding: 6px; border-radius: var(--r-pill); background: var(--glass-light-bg); backdrop-filter: var(--glass-light-filter); -webkit-backdrop-filter: var(--glass-light-filter); box-shadow: var(--glass-light-shadow); }
  .fbar-sp { flex: 1; }
  .fbar-count { font-size: var(--t-small); white-space: nowrap; }
  .fbar-count b { color: var(--ink); }
  .dd { position: relative; flex-shrink: 0; }
  .dd-btn { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; padding: 0 14px 0 18px; border-radius: var(--r-pill); font-size: var(--t-small); font-weight: 500; }
  .dd-btn.set { background: var(--ink); color: var(--white); }
  .dd-k { color: var(--text-secondary); }
  .dd-btn.set .dd-k { color: var(--mist); }
  .chev { width: 7px; height: 7px; margin: 0 2px 3px; border-right: 2px solid currentColor; border-bottom: 2px solid currentColor; transform: rotate(45deg); transition: transform var(--d-base) var(--ease); }
  .dd-btn[aria-expanded='true'] .chev { transform: rotate(-135deg); }
  .dd-list { position: absolute; top: calc(100% + 10px); left: 0; width: 340px; padding: 6px; border-radius: var(--r-inner); background: var(--glass-sheet-bg); backdrop-filter: var(--glass-sheet-filter); -webkit-backdrop-filter: var(--glass-sheet-filter); box-shadow: var(--glass-sheet-shadow); display: flex; flex-direction: column; gap: 2px; z-index: 2; }
  .dd-scrim { position: fixed; inset: 0; z-index: 39; cursor: default; }
  .frow { display: flex; align-items: center; gap: 12px; width: 100%; min-height: 44px; padding: 0 12px; border-radius: var(--r-tile); text-align: left; font-size: 15px; font-weight: 500; }
  .frow:hover:not(:disabled), .frow[aria-pressed='true'] { background: var(--hover); }
  .fdot { flex-shrink: 0; width: 20px; height: 20px; border-radius: var(--r-dot); display: inline-flex; align-items: center; justify-content: center; box-shadow: inset 0 0 0 1.5px var(--line); color: var(--white); font-size: var(--t-label); }
  .frow[aria-pressed='true'] .fdot { background: var(--ink); box-shadow: none; }
  .frow[aria-pressed='true'] .fdot::after { content: '✓'; }
  .frow-l { flex: 1; min-width: 0; }
  .frow-n { font-size: var(--t-small); color: var(--text-muted); }
  .sheet :global(.seg.full .seg-b) { min-height: 40px; }
  @media (max-width: 1099px) { .work :global(.only-d) { display: none; } }

  /* Phone filter pill + sheet */
  .fpill-wrap { position: fixed; left: 12px; right: 12px; bottom: calc(12px + env(safe-area-inset-bottom)); z-index: 45; display: flex; justify-content: center; pointer-events: none; }
  @media (min-width: 640px) { .fpill-wrap { display: none !important; } }
  :global(html.menu-open) .fpill-wrap { display: none !important; }
  .fpill { display: flex; align-items: center; gap: 4px; padding: 5px; border-radius: var(--r-pill); background: var(--glass-light-bg); backdrop-filter: var(--glass-light-filter); -webkit-backdrop-filter: var(--glass-light-filter); box-shadow: var(--glass-light-shadow); pointer-events: auto; }
  .fpill-btn { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; padding: 0 16px; border-radius: var(--r-pill); background: var(--ink); color: var(--white); font-size: var(--t-small); font-weight: 500; }
  .fpill-ic { display: flex; flex-direction: column; align-items: center; gap: 3px; }
  .fpill-ic i { height: 2px; border-radius: 2px; background: var(--white); width: 14px; }
  .fpill-ic i:nth-child(2) { width: 10px; }
  .fpill-ic i:nth-child(3) { width: 6px; }
  .fpill-n { padding: 0 10px 0 6px; font-size: var(--t-small); }
  .sheet { position: fixed; inset: 0; z-index: 70; display: flex; flex-direction: column; justify-content: flex-end; }
  .sheet-scrim { position: absolute; inset: 0; background: var(--scrim); cursor: default; }
  .sheet-panel:focus { outline: none; }
