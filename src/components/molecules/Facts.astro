---
// Key–value list (role, company, year…). `dark` on ink panels, `light` on white.
interface Props { items: { k: string; v: string }[]; tone?: 'dark' | 'light'; class?: string; [attr: string]: unknown }
const { items, tone = 'dark', class: cls, ...rest } = Astro.props;
---
<dl class:list={['facts', `facts-${tone}`, cls]} {...rest}>
  {items.map((f) => <div><dt class:list={['label', tone === 'dark' ? 'on-ink-muted' : 'muted']}>{f.k}</dt><dd>{f.v}</dd></div>)}
</dl>

<style is:global>
  .facts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px 16px; }
  .facts > div { display: flex; flex-direction: column; gap: 4px; }
  .facts dd { font-size: var(--t-body); }
  .facts-dark { border-top: 1px solid var(--on-dark-line); padding-top: 16px; }
  .facts-light > div { padding-top: 12px; border-top: 1px solid var(--muted-on-ink); }
  .facts-light dd { font-weight: 500; }
</style>
