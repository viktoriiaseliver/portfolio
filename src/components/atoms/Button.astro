---
// Button atom. Renders <a> with href, otherwise <button type="button">. Min height 44px.
interface Props {
  href?: string;
  variant?: 'brand' | 'ink' | 'white' | 'outline' | 'outline-light' | 'text';
  size?: 'sm' | 'md' | 'lg';
  arrow?: boolean;
  onBrand?: boolean;   // white button on a cobalt surface: cobalt text
  class?: string;
  [attr: string]: unknown;
}
const { href, variant = 'ink', size = 'md', arrow = false, onBrand = false, class: cls, ...rest } = Astro.props;
const Tag = href ? 'a' : 'button';
---
<Tag href={href} type={href ? undefined : 'button'} class:list={['btn', `btn-${variant}`, { sm: size === 'sm', lg: size === 'lg', 'has-arr': arrow, 'on-brand': onBrand }, cls]} {...rest}>
  <slot />{arrow && <span class="arr" aria-hidden="true">→</span>}
</Tag>
