---
// Phone frame atom with an image slot inside.
import Slot from './Slot.astro';
interface Props { label: string; src?: string; class?: string; style?: string; [attr: string]: unknown }
const { label, src, class: cls, style, ...rest } = Astro.props;
---
<div class:list={['phone', cls]} style={style} {...rest}><div><Slot label={label} src={src} /></div></div>
