---
import { url } from '../../lib/url';
import Segmented from '../atoms/Segmented.astro';
interface Props { links: { href: string; label: string; active?: boolean }[]; cta?: { label: string; href: string }; progress?: boolean; depth?: boolean }
const { links, cta = { label: 'Contact', href: '#contact' }, progress = false, depth = false } = Astro.props;
// Case pages: Short · 1 min / Full · 5 min reading switch.
const depthItems = (short: boolean) => [['short', 'Short · 1 min'], ['full', 'Full · 5 min']].map(([k, t]) => ({ label: short ? t.split(' · ')[1] : t, selected: k === 'full', attrs: { 'data-depth-pick': k } }));
---
<nav class="nav" aria-label="Main" data-nav>
  <div class="nav-bar">
    <a class="nav-name" href={url('/')}>Viktoriia Seliverstova</a>
    <div class="nav-wide">
      {links.map((l) => <a class:list={['nav-link', { on: l.active }]} href={url(l.href)} aria-current={l.active ? 'page' : undefined}>{l.label}</a>)}
      {depth && <Segmented items={depthItems(false)} label="Reading depth" role="tablist" tone="soft" />}
      <a class="nav-cta" href={url(cta.href)}>{cta.label}</a>
    </div>
    <button class="nav-menu-btn" type="button" aria-expanded="false" aria-controls="nav-sheet" data-nav-toggle>Menu</button>
    {progress && <i class="nav-progress" aria-hidden="true" data-progress></i>}
  </div>
  <div class="nav-sheet" id="nav-sheet" hidden>
    {links.map((l) => <a class:list={['nav-sheet-link', { on: l.active }]} href={url(l.href)}>{l.label}</a>)}
    {depth && <div class="depth-wrap"><Segmented items={depthItems(true)} label="Reading depth" role="tablist" tone="soft" /></div>}
    <a class="nav-sheet-cta" href={url(cta.href)}>{cta.label}</a>
  </div>
</nav>

<style>
  .nav { position: fixed; top: 10px; left: 0; right: 0; z-index: 50; padding: 0 clamp(10px, 2vw, 32px); pointer-events: none; transition: transform var(--d-base) var(--ease); }
  :global(html.nav-hidden) .nav:not(.open) { transform: translateY(calc(-100% - 16px)); }
  .nav-bar { position: relative; max-width: var(--nav-max); margin: 0 auto; padding: 6px 6px 6px 20px; border-radius: var(--r-pill); background: var(--glass-light-bg); backdrop-filter: var(--glass-light-filter); -webkit-backdrop-filter: var(--glass-light-filter); box-shadow: var(--glass-light-shadow); display: flex; align-items: center; gap: 4px; pointer-events: auto; overflow: hidden; }
  .nav-name { display: block; line-height: 44px; min-width: 0; overflow: hidden; text-overflow: ellipsis; font-size: var(--t-body); font-weight: 500; color: var(--ink); text-decoration: none; white-space: nowrap; margin-right: auto; }
  .nav-wide { display: flex; align-items: center; gap: 4px; }
  .nav-link { display: inline-flex; align-items: center; min-height: var(--control-min); padding: 0 14px; border-radius: var(--r-pill); font-size: var(--t-small); text-decoration: none; white-space: nowrap; color: var(--ink); }
  .nav-link:hover, .nav-link.on { background: var(--hover); color: var(--ink); }
  .nav-cta { display: inline-flex; align-items: center; min-height: var(--control-min); padding: 0 18px; border-radius: var(--r-pill); background: var(--ink); color: var(--white); font-size: var(--t-small); text-decoration: none; white-space: nowrap; }
  .nav-cta:hover { color: var(--white); background: var(--cobalt); }
  .nav-menu-btn { display: none; flex-shrink: 0; min-height: var(--control-min); padding: 0 18px; border-radius: var(--r-pill); background: var(--ink); color: var(--white); font-size: var(--t-small); }
  .nav-sheet { max-width: var(--nav-max); margin: 8px auto 0; padding: 8px; border-radius: var(--r-card); background: var(--glass-sheet-bg); backdrop-filter: var(--glass-sheet-filter); -webkit-backdrop-filter: var(--glass-sheet-filter); box-shadow: var(--glass-sheet-shadow); display: flex; flex-direction: column; gap: 4px; pointer-events: auto; }
  .nav-sheet[hidden] { display: none; }
  .nav-sheet-link { padding: 16px 18px; border-radius: var(--r-inner); font-size: 20px; font-weight: 500; letter-spacing: -.03em; text-decoration: none; color: var(--ink); }
  .nav-sheet-link.on { background: var(--hover); }
  .nav-sheet-cta { margin-top: 4px; padding: 16px 18px; border-radius: var(--r-pill); background: var(--ink); color: var(--white); font-size: var(--t-body); text-align: center; text-decoration: none; }
  .nav-sheet-cta:hover { color: var(--white); }
  .nav-progress { position: absolute; left: 0; bottom: 0; height: 3px; width: 0; background: var(--cobalt); }
  .depth-wrap { padding: 8px 10px; display: flex; }
  @media (max-width: 639px) {
    .nav-wide { display: none; }
    .nav-menu-btn { display: block; }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]')!;
  const btn = nav.querySelector<HTMLButtonElement>('[data-nav-toggle]')!;
  const sheet = nav.querySelector<HTMLElement>('.nav-sheet')!;
  const root = document.documentElement;

  const setMenu = (open: boolean) => {
    nav.classList.toggle('open', open);
    sheet.hidden = !open;
    btn.setAttribute('aria-expanded', String(open));
    btn.textContent = open ? 'Close' : 'Menu';
    root.classList.toggle('menu-open', open);
  };
  btn.addEventListener('click', () => setMenu(sheet.hidden));
  sheet.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) setMenu(false); });
  addEventListener('keydown', (e) => { if (e.key === 'Escape' && !sheet.hidden) { setMenu(false); btn.focus(); } });
  matchMedia('(min-width: 640px)').addEventListener('change', (e) => { if (e.matches) setMenu(false); });

  // Reading progress line along the bottom of the pill (case pages).
  const bar = nav.querySelector<HTMLElement>('[data-progress]');
  if (bar) {
    const paint = () => { const d = document.documentElement; bar.style.width = Math.max(0, Math.min(100, (d.scrollTop / Math.max(1, d.scrollHeight - d.clientHeight)) * 100)) + '%'; };
    addEventListener('scroll', paint, { passive: true });
    paint();
  }

  // Hide on scroll down past 240px; any scroll up (>6px) or being near the top brings it back.
  let last = scrollY;
  addEventListener('scroll', () => {
    const y = scrollY, d = y - last;
    last = y;
    if (y > 240 && d > 6) root.classList.add('nav-hidden');
    else if (d < -6 || y < 240) root.classList.remove('nav-hidden');
  }, { passive: true });
</script>
