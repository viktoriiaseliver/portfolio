---
import Slot from '../atoms/Slot.astro';
import Chip from '../atoms/Chip.astro';
import Button from '../atoms/Button.astro';
import Status from '../molecules/Status.astro';
import Heading from '../atoms/Heading.astro';
import { url } from '../../lib/url';
import { EMAIL, TELEGRAM, LINKEDIN, CV_URL, WALKTHROUGH, STATUS } from '../../data/site';

interface Props {
  a?: string; b?: string; status?: string; label?: string;
  terms?: { t: string; c: string }[];
  primaryLabel?: string; primaryHref?: string;
  showAbout?: boolean; minH?: string;
  imageId?: string; imagePh?: string;
}
const {
  a = 'Hiring for a senior ', b = 'product role?', status = STATUS, label, terms = [],
  primaryLabel = 'Ask for a 20-minute walkthrough', primaryHref = WALKTHROUGH,
  showAbout = false, minH = '60svh', imageId, imagePh = 'Illustration'
} = Astro.props;

// Long headlines drop to h3 size.
const long = a.length + b.length > 60;
const links = [
  { t: 'Telegram ↗', href: TELEGRAM, ext: true },
  { t: 'LinkedIn ↗', href: LINKEDIN, ext: true },
  ...(showAbout ? [{ t: 'About me →', href: url('/about'), ext: false }] : []),
  { t: 'Download CV', href: url(CV_URL), ext: false }
];
---
<section id="contact" class="contact section">
  <div class:list={['contact-panel', { 'has-image': !!imageId }]} style={`min-height:${minH}`}>
    <div class="contact-main">
      <div class="contact-top">
        <Status text={status} class="mist" />
        {label && <span class="label-s mist" style="letter-spacing:.06em">{label}</span>}
        <h2 class:list={['contact-h', long ? 'h3' : 'display', { long }]}><span data-contact-a>{a}</span><span class="serif mist" data-contact-b>{b}</span></h2>
        {terms.length > 0 && (
          <div class="contact-terms">{terms.map((t) => <Chip tone="dark" ring tall dot={t.c}>{t.t}</Chip>)}</div>
        )}
      </div>
      <div class="contact-bottom">
        <button class="contact-email" type="button" data-copy-email={EMAIL}>
          <span class="contact-email-addr">{EMAIL}</span><span class="contact-copy" aria-live="polite" data-copy-label>COPY</span>
        </button>
        <div class="contact-row">
          <div class="contact-links">
            <Button href={primaryHref} variant="white" size="lg" onBrand class="contact-primary">{primaryLabel}</Button>
            {links.map((l) => <Button href={l.href} variant="outline-light" size="lg" target={l.ext ? '_blank' : undefined} rel={l.ext ? 'noopener' : undefined}>{l.t}</Button>)}
          </div>
          <span class="contact-copy-r mist">© 2026 Viktoriia Seliverstova</span>
        </div>
      </div>
    </div>
    {imageId && <div class="contact-image"><Slot label={imagePh} /></div>}
  </div>
</section>

<style>
  .contact { display: flex; }
  .contact-panel { flex: 1; min-width: 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: 24px 40px; border-radius: var(--r-surface); background: var(--cobalt); color: var(--white); padding: var(--panel-pad); }
  @media (min-width: 640px) { .contact-panel.has-image { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .contact-main { min-width: 0; display: flex; flex-direction: column; justify-content: space-between; gap: 48px; }
  .contact-top { display: flex; flex-direction: column; gap: 20px; }
  .contact-h { letter-spacing: -.05em; max-width: 16ch; }
  .contact-h.long { line-height: 1; max-width: 28ch; }
  .contact-links :global(.contact-primary) { font-weight: 500; }
  .contact-links :global(.btn) { white-space: normal; text-align: center; }
  .contact-terms :global(.dot) { width: 10px; height: 10px; }
  .contact-terms { display: flex; flex-wrap: wrap; gap: 8px; }
  .contact-bottom { display: flex; flex-direction: column; gap: 18px; }
  .contact-email { align-self: flex-start; display: inline-flex; align-items: center; gap: 12px; flex-wrap: wrap; max-width: 100%; padding: 10px 0; font-size: clamp(18px, 2.6vw, 40px); font-weight: 500; letter-spacing: -.03em; color: var(--white); text-align: left; overflow-wrap: anywhere; }
  .contact-email:hover { opacity: .85; }
  .contact-email-addr { text-decoration: underline; text-underline-offset: .18em; text-decoration-thickness: 2px; }
  .contact-copy { padding: 6px 12px; border-radius: var(--r-pill); background: var(--white); color: var(--cobalt); font-size: var(--t-label); font-weight: 500; letter-spacing: .06em; }
  .contact-row { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; align-items: center; }
  .contact-links { display: flex; gap: 12px; flex-wrap: wrap; }
  .contact-copy-r { font-size: var(--t-small); }
  .contact-image { display: flex; min-height: 320px; border-radius: var(--r-inner); overflow: hidden; background: var(--on-dark-fill); }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy-email]').forEach((b) => {
    const label = b.querySelector<HTMLElement>('[data-copy-label]')!;
    let t: number | undefined;
    b.addEventListener('click', () => {
      navigator.clipboard?.writeText(b.dataset.copyEmail!).catch(() => {});
      label.textContent = 'COPIED';
      clearTimeout(t);
      t = window.setTimeout(() => { label.textContent = 'COPY'; }, 1500);
    });
  });
</script>
